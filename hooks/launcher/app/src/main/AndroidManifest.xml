<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"/>

    <application
        android:label="耀衍"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false">
        <meta-data android:name="xposedmodule" android:value="true"/>
        <meta-data android:name="xposeddescription"
            android:value="荣耀 MagicOS 8.0 系统交互/动效优化"/>
        <meta-data android:name="xposedminversion" android:value="93"/>
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope"/>
        <activity
            android:name="com.wxz.hnlauncherport.SettingsActivity"
            android:exported="true"
            android:label="耀衍"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.HnPort.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
